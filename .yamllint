---
# GitHub Actions ワークフロー・Issue テンプレートの構文チェック用（CI の lint ジョブから実行）。
# 既定の line-length（80）は日本語の説明文がすぐ超えるため緩め、
# GitHub Actions の慣習にない document-start（先頭 `---`）要求も外す。
extends: default

rules:
  line-length:
    max: 150
  document-start: disable
  # GitHub Actions の `on:` キーが truthy と誤検出されるため、キーは判定対象外にする（値の yes/no は引き続き検出）
  truthy:
    check-keys: false
